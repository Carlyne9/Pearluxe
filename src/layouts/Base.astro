---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartToast from '../components/CartToast.astro';

interface Props {
  title: string;
  description?: string;
  /** Homepage: header floats over the video hero. */
  overlayHeader?: boolean;
  /** Checkout: logo-only header, no cart pop-up. */
  checkout?: boolean;
}

const { title, description = 'Pearluxe: bags, curated.', overlayHeader = false, checkout = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#6E1F57" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <Header overlay={overlayHeader} minimal={checkout} />
    <slot />
    {!checkout && <CartToast />}
  </body>
</html>
