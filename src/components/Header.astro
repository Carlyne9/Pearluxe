---
import Logo from './Logo.astro';

interface Props {
  /** Transparent over the homepage video until the page scrolls. */
  overlay?: boolean;
  /** Checkout: logo only, so nothing distracts from paying. */
  minimal?: boolean;
}

const { overlay = false, minimal = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar container">
    <a class="brand" href="/" aria-label="Pearluxe home">
      <Logo variant="monogram" class="mono" />
      <Logo variant="wordmark" class="word" />
    </a>

    {minimal ? <span class="secure">🔒 Secure checkout</span> : <>
    <nav class="nav" aria-label="Main">
      <a href="/bags">Shop</a>
      <a class="wide" href="/bags?tab=new">New in</a>
      <a class="wide" href="/bags?tab=sale">Sale</a>
    </nav>

    <div class="icons">
      <a class="icon" href="/bags?tab=favs" aria-label="Favourites">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.4 0 5.6 3.5 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
      </a>
      <a class="icon" href="/cart" data-cart-link aria-label="Cart, 0 items">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
        <span class="count" data-cart-count hidden>0</span>
      </a>
    </div>
    </>}
  </div>
</header>

<script>
  import { getCart } from '../lib/store';

  const count = document.querySelector<HTMLElement>('[data-cart-count]');
  const link = document.querySelector<HTMLElement>('[data-cart-link]');
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  function syncCount() {
    if (!count || !link) return;
    const n = getCart().reduce((sum, i) => sum + i.qty, 0);
    count.textContent = String(n);
    count.hidden = n === 0;
    link.setAttribute('aria-label', `Cart, ${n} ${n === 1 ? 'item' : 'items'}`);
  }

  document.addEventListener('store:change', syncCount);
  syncCount();

  // Overlay header turns solid once the hero scrolls away.
  if (header.classList.contains('overlay')) {
    const onScroll = () => header.classList.toggle('solid', scrollY > 40);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    transition: background var(--dur-ui) var(--ease), color var(--dur-ui) var(--ease);
  }
  .overlay { position: fixed; left: 0; right: 0; background: transparent; border-color: transparent; color: var(--color-on-dark); }
  .overlay.solid { background: var(--color-bg); border-color: var(--color-line); color: var(--color-ink); }
  .bar { display: flex; align-items: center; gap: var(--space-6); min-height: 64px; }
  .brand { display: flex; align-items: center; gap: var(--space-3); color: inherit; }
  .brand :global(.mono) { width: 28px; height: auto; }
  .brand :global(.word) { width: 104px; height: auto; }
  .nav { display: flex; gap: var(--space-6); margin-left: auto; }
  .nav a { color: inherit; text-decoration: none; font-size: var(--text-sm); }
  .wide { display: none; }
  .secure { margin-left: auto; font-size: var(--text-sm); color: var(--color-ink-muted); }
  .icons { display: flex; }
  .icon { position: relative; display: grid; place-items: center; width: var(--tap-min); height: var(--tap-min); color: inherit; }
  .icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--color-primary);
    color: var(--color-on-dark);
    font-size: 11px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
  }
  @media (max-width: 359px) { .brand :global(.word) { display: none; } }
  @media (min-width: 768px) {
    .wide { display: inline; }
    .nav { margin-left: var(--space-8); }
    .icons { margin-left: auto; }
  }
  @media (hover: hover) { .nav a:hover { text-decoration: underline; text-underline-offset: 4px; } }
</style>
