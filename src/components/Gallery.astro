---
// Swipeable photos (native scroll-snap on touch; arrows appear for mouse users). An optional video plays as the first slide.
interface Props {
  images: string[];
  alt: string;
  href?: string;
  video?: { src: string; poster: string };
  /** False for colors not shown yet, so their video doesn't download or play in the background. */
  autoplay?: boolean;
}

const { images, alt, href, video, autoplay = true } = Astro.props;
const slides = images.length + (video ? 1 : 0);
---

<div class="gallery">
  <div class="track" data-track>
    {video && <video src={video.src} poster={video.poster} autoplay={autoplay} muted loop playsinline preload={autoplay ? 'metadata' : 'none'} aria-label={`${alt}, video`} data-slide-video></video>}
    {images.map((src, i) => {
      const img = <img src={src} alt={`${alt}, photo ${i + 1} of ${images.length}`} loading={i ? 'lazy' : 'eager'} draggable="false" />;
      return href ? <a href={href} tabindex={i ? -1 : 0}>{img}</a> : img;
    })}
  </div>
  {slides > 1 && (
    <>
      <button class="arrow prev" type="button" data-step="-1" aria-label="Previous photo">‹</button>
      <button class="arrow next" type="button" data-step="1" aria-label="Next photo">›</button>
      <div class="dots" aria-hidden="true">
        {Array.from({ length: slides }, (_, i) => <span class:list={{ on: i === 0 }} />)}
      </div>
    </>
  )}
</div>

<style>
  .gallery { position: absolute; inset: 0; }
  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar { display: none; }
  .track > * { flex: 0 0 100%; scroll-snap-align: start; }
  .track img, .track video { width: 100%; height: 100%; object-fit: cover; }
  .arrow {
    display: none;
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    color: var(--color-ink);
    font-size: var(--text-xl);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease);
  }
  .prev { left: var(--space-2); }
  .next { right: var(--space-2); }
  @media (hover: hover) {
    .arrow { display: grid; place-items: center; }
    .gallery:hover .arrow, .arrow:focus-visible { opacity: 1; }
  }
  .dots {
    position: absolute;
    bottom: var(--space-3);
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: var(--space-1);
    pointer-events: none;
  }
  .dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 25%, transparent);
    transition: background var(--dur-ui) var(--ease);
  }
  .dots .on { background: var(--color-ink); }
</style>
