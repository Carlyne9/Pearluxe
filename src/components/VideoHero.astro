---
// Home hero. The client's videos are portrait, so: full screen on phones, beside the headline on tablet+.
// Clips play one after another, then start over. Each is loaded only when its turn comes.
const clips = ['brown-buckle-bag', 'jacquard-shoulder-bags']; // files in public/videos/: <name>.mp4 + <name>.jpg poster
---

<section class="video-hero">
  <div class="media">
    <video
      data-hero-video
      data-clips={JSON.stringify(clips)}
      src={`/videos/${clips[0]}.mp4`}
      poster={`/videos/${clips[0]}.jpg`}
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <button class="toggle" type="button" data-hero-toggle data-paused="true" aria-label="Play video">
      <svg class="icon-play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" /></svg>
    </button>
  </div>

  <div class="copy">
    <p class="caps">New in</p>
    <h1>Bags, curated.</h1>
    <a class="btn" href="/bags">Shop bags</a>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');

  if (video && toggle) {
    const setPaused = (paused: boolean) => {
      if (paused) video.pause();
      else video.play().catch(() => setPaused(true)); // autoplay blocked (e.g. Low Power Mode): show the play button
      toggle.dataset.paused = String(paused);
      toggle.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    };
    // Reduced motion: stay on the poster until the shopper presses play.
    setPaused(matchMedia('(prefers-reduced-motion: reduce)').matches);
    toggle.addEventListener('click', () => setPaused(!video.paused));

    const clips: string[] = JSON.parse(video.dataset.clips!);
    let current = 0;
    video.addEventListener('ended', () => {
      current = (current + 1) % clips.length;
      video.poster = `/videos/${clips[current]}.jpg`; // shows while the next clip loads
      video.src = `/videos/${clips[current]}.mp4`;
      setPaused(false);
    });
  }
</script>

<style>
  .video-hero {
    display: grid;
    height: min(88svh, 56rem);
    background: var(--color-ink);
    color: var(--color-on-dark);
  }

  /* Phones: video and copy share one cell, copy sits on the bottom of the video. */
  .media, .copy { grid-area: 1 / 1; min-height: 0; }

  .media { position: relative; }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%; /* keeps the bag in frame when the sides or top get cropped */
  }

  .toggle {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 50%, transparent);
    color: var(--color-on-dark);
    cursor: pointer;
  }
  .toggle[data-paused='true'] .icon-pause,
  .toggle[data-paused='false'] .icon-play { display: none; }

  .copy {
    z-index: 1;
    align-self: end;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-16) var(--gutter) var(--space-8);
    background: linear-gradient(to top, color-mix(in srgb, var(--color-ink) 70%, transparent), transparent);
  }
  .copy p { margin: 0; }
  h1 { font-size: var(--text-hero); }

  /* Tablet + desktop: headline left, video right. */
  @media (min-width: 768px) {
    .video-hero {
      grid-template-columns: 1fr 1fr;
      background: var(--color-lavender-soft);
      color: var(--color-ink);
    }
    .media { grid-area: 1 / 2; }
    .copy {
      grid-area: 1 / 1;
      align-self: center;
      padding: var(--space-16) var(--gutter);
      background: none;
    }
  }
</style>
