---
// Shown after "Add to cart": lets the shopper keep browsing or go to checkout. Opened from src/scripts/product.ts.
---

<div class="toast" role="status" aria-live="polite" data-cart-toast hidden>
  <p class="msg"><span class="tick" aria-hidden="true">✓</span> <span data-toast-text>Added to cart</span></p>
  <div class="actions">
    <button class="btn btn--outline" type="button" data-toast-close>Continue shopping</button>
    <a class="btn" href="/cart">Checkout</a>
  </div>
</div>

<style>
  .toast {
    position: fixed;
    z-index: 30;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-3);
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 12px 40px rgb(28 22 34 / 0.18);
    animation: rise var(--dur-image) var(--ease);
  }
  @media (min-width: 768px) {
    .toast { left: auto; right: var(--gutter); bottom: var(--gutter); width: 380px; }
  }
  @keyframes rise { from { opacity: 0; translate: 0 12px; } }
  .msg { margin: 0; font-size: var(--text-sm); }
  .tick { color: var(--color-primary); font-weight: 600; }
  .actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .actions .btn { padding-inline: var(--space-2); letter-spacing: 0.06em; }
</style>
