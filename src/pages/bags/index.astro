---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';

const tabs = [
  ['all', 'All'],
  ['new', 'New'],
  ['sale', 'Sale'],
  ['favs', 'Favourites'],
];
---

<Base title="Bags · Pearluxe">
  <main class="container">
    <header class="head">
      <h1>Bags</h1>
      <p class="count" data-count>{products.length} bags</p>
    </header>

    <nav class="tabs" aria-label="Filter bags">
      {tabs.map(([id, label], i) => (
        <button type="button" class="tab" data-filter={id} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
      ))}
    </nav>

    <div class="grid" data-grid>
      {products.map((p) => <ProductCard product={p} />)}
    </div>
    <p class="empty" data-empty hidden>No favourites yet. Tap the heart on any bag to save it here.</p>
  </main>
</Base>

<script>
  import { getFavorites } from '../../lib/store';

  // shortcut: temporary heart-position test toggle (?fav=image).
  const favLayout = new URLSearchParams(location.search).get('fav');
  if (favLayout) document.documentElement.dataset.fav = favLayout;

  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] [data-product]');
  const count = document.querySelector('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let filter = 'all';

  function apply() {
    const favs = getFavorites();
    let shown = 0;
    cards.forEach((card) => {
      const tags = card.dataset.tags!.split(' ');
      const show = filter === 'all' || (filter === 'favs' ? favs.includes(card.dataset.product!) : tags.includes(filter));
      card.hidden = !show;
      if (show) shown++;
    });
    count.textContent = `${shown} ${shown === 1 ? 'bag' : 'bags'}`;
    empty.hidden = !(filter === 'favs' && shown === 0);
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.filter === filter)));
  }

  tabs.forEach((t) => t.addEventListener('click', () => { filter = t.dataset.filter!; apply(); }));

  // Deep link from the home page, e.g. /bags?tab=new
  const initial = new URLSearchParams(location.search).get('tab');
  if (initial && [...tabs].some((t) => t.dataset.filter === initial)) {
    filter = initial;
    apply();
  }
  document.addEventListener('store:change', apply);
</script>

<style>
  .head { display: flex; align-items: baseline; justify-content: space-between; padding-top: var(--space-8); }
  h1 { font-size: var(--text-2xl); }
  .count { margin: 0; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .tabs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-block: var(--space-6);
    scrollbar-width: none;
  }
  .tab {
    flex: none;
    min-height: var(--tap-min);
    padding: 0 var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .tab[aria-pressed='true'] { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-dark); }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    gap: var(--space-12) var(--space-4);
    padding-bottom: var(--space-24);
  }
  @media (min-width: 1280px) { .grid { column-gap: var(--space-6); } }
  .empty { color: var(--color-ink-muted); padding-bottom: var(--space-24); }
</style>
