---
import Base from '../layouts/Base.astro';
import { cartCatalog, ghs } from '../data/products';
import { pickup, shipOptions } from '../data/delivery';

const catalog = cartCatalog();
const regions = [
  'Greater Accra', 'Ashanti', 'Ahafo', 'Bono', 'Bono East', 'Central', 'Eastern', 'North East',
  'Northern', 'Oti', 'Savannah', 'Upper East', 'Upper West', 'Volta', 'Western', 'Western North',
];
---

<Base title="Checkout · Pearluxe" checkout>
  <main class="container layout">
    <a href="/cart" class="back-top">← Back to cart</a>
    <!-- Phones: order summary folds up above the form. Desktop: always open on the right. -->
    <details class="summary" data-summary>
      <summary class="summary-toggle">
        <span>Order summary</span>
        <strong data-total></strong>
      </summary>
      <div class="summary-body">
        <ul class="lines" data-lines></ul>
        <dl>
          <div><dt data-items-label>Subtotal</dt><dd data-subtotal></dd></div>
          <div><dt>Delivery</dt><dd data-fee>Choose below</dd></div>
          <div class="total"><dt>Total</dt><dd><small>GHS</small> <span data-total></span></dd></div>
        </dl>
      </div>
    </details>

    <form class="form" data-form novalidate>
      <p class="guest">No account needed. Check out as a guest.</p>

      <section>
        <h2>Contact</h2>
        <div class="row">
          <label>First name<input name="firstName" autocomplete="given-name" required /></label>
          <label>Last name<input name="lastName" autocomplete="family-name" required /></label>
        </div>
        <label>Phone
          <span class="phone"><span>+233</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="24 123 4567" pattern="0?[235][0-9 ]{8,10}" required /></span>
        </label>
        <label><span>Email <small>(for your receipt)</small></span><input name="email" type="email" autocomplete="email" required /></label>
        <label class="check"><input type="checkbox" name="whatsapp" checked /> Send order updates on WhatsApp</label>
      </section>

      <section>
        <h2>Delivery</h2>
        <div class="segmented" role="radiogroup" aria-label="Delivery method">
          <label><input class="sr-only" type="radio" name="delivery" value="ship" checked data-method /><span>Delivery</span></label>
          <label><input class="sr-only" type="radio" name="delivery" value="pickup" data-method /><span>Pickup</span></label>
        </div>

        <fieldset class="ship" data-ship>
          <legend class="sr-only">Delivery address</legend>
          <div class="row">
            <label>Region
              <select name="region" data-region required>
                {regions.map((r) => <option>{r}</option>)}
              </select>
            </label>
            <label>City / town<input name="city" autocomplete="address-level2" required /></label>
          </div>
          <label>Address or landmark<input name="address" autocomplete="street-address" placeholder="e.g. Near Shiashie Total filling station" required /></label>
          <label><span>GhanaPost GPS <small>(optional)</small></span><input name="gps" placeholder="GA-123-4567" /></label>

          <p class="label">Delivery area</p>
          <div class="options" data-zones>
            {shipOptions.map((o) => (
              <label class="option" data-zone={o.id}>
                <input type="radio" name="zone" value={o.id} data-fee={o.fee} required />
                <span class="option-text">{o.label}{o.note && <small>{o.note}</small>}</span>
                <strong>{ghs(o.fee)}</strong>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="options" data-pickup hidden>
          <label class="option selected">
            <input type="radio" name="pickupOption" value={pickup.id} checked disabled />
            <span class="option-text">{pickup.label}<small>{pickup.note}</small></span>
            <strong>Free</strong>
          </label>
        </div>
      </section>

      <section>
        <h2>Payment</h2>
        <div class="paystack">
          <div class="paystack-head"><strong>Paystack</strong><span>Card · MTN MoMo · Telecel Cash · AirtelTigo Money</span></div>
          <p>You'll be sent to Paystack to pay securely. All transactions are encrypted.</p>
        </div>
      </section>

      <p class="notice" data-notice role="status" hidden></p>

      <div class="actions">
        <a href="/cart" class="back">← Return to cart</a>
        <button class="btn pay" type="submit">Pay&nbsp;<span data-total></span></button>
      </div>
    </form>
  </main>
</Base>

<script is:inline define:vars={{ catalog }}>
  window.__catalog = catalog;
</script>

<script>
  import { cartLines, cartTotals, esc, ghs } from '../lib/cart-view';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const form = $<HTMLFormElement>('[data-form]');
  const ship = $<HTMLFieldSetElement>('[data-ship]');
  const pickupBox = $('[data-pickup]');
  const region = $<HTMLSelectElement>('[data-region]');

  if (!cartLines().length) location.replace('/cart');

  // Desktop shows the summary open; phones start folded.
  if (matchMedia('(min-width: 1024px)').matches) $<HTMLDetailsElement>('[data-summary]').open = true;

  const fee = () => {
    if ((form.elements.namedItem('delivery') as RadioNodeList).value === 'pickup') return 0;
    const zone = form.querySelector<HTMLInputElement>('[name=zone]:checked:not(:disabled)');
    return zone ? Number(zone.dataset.fee) : null;
  };

  function render() {
    const { count, subtotal } = cartTotals();
    const f = fee();
    $('[data-items-label]').textContent = `Subtotal · ${count} ${count === 1 ? 'item' : 'items'}`;
    $('[data-subtotal]').textContent = ghs(subtotal);
    $('[data-fee]').textContent = f === null ? 'Choose below' : f === 0 ? 'Free' : ghs(f);
    document.querySelectorAll('[data-total]').forEach((el) => (el.textContent = ghs(subtotal + (f ?? 0))));
    $('[data-lines]').innerHTML = cartLines()
      .map((l) => `
        <li>
          <span class="thumb"><img src="${l.image}" alt="" /><b>${l.qty}</b></span>
          <span class="li-text">${esc(l.product.name)}<small>${[l.color, l.size].filter(Boolean).map((s) => esc(s!)).join(' · ')}</small></span>
          <span>${ghs(l.product.price * l.qty)}</span>
        </li>`)
      .join('');
  }

  // Outside Greater Accra, the only delivery option is the bus station.
  function syncZones() {
    const outside = region.value !== 'Greater Accra';
    form.querySelectorAll<HTMLElement>('[data-zone]').forEach((z) => {
      const isOutside = z.dataset.zone === 'outside-accra';
      z.hidden = outside ? !isOutside : isOutside;
      const input = z.querySelector('input')!;
      if (z.hidden) input.checked = false;
      if (outside && isOutside) input.checked = true;
    });
    render();
  }

  function syncMethod() {
    const isPickup = (form.elements.namedItem('delivery') as RadioNodeList).value === 'pickup';
    ship.disabled = isPickup; // disabled fields are skipped by validation
    ship.hidden = isPickup;
    pickupBox.hidden = !isPickup;
    render();
  }

  form.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (t.matches('[data-method]')) syncMethod();
    else if (t === region) syncZones();
    else render();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    // shortcut: Paystack not connected yet; needs the client's Paystack account (public key + server-side verification).
    const notice = $('[data-notice]');
    notice.hidden = false;
    notice.textContent = 'Details look good. Paystack payment will open here once the shop’s Paystack account is connected.';
  });

  syncZones();
  syncMethod();
</script>

<style>
  .layout { display: grid; gap: var(--space-6); padding-block: var(--space-6) var(--space-24); }
  @media (min-width: 1024px) {
    .layout { grid-template-columns: minmax(0, 620px) minmax(440px, 1fr); column-gap: var(--space-16); align-items: start; padding-top: var(--space-12); }
    .summary { order: 2; position: sticky; top: calc(64px + var(--space-6)); }
  }

  .back-top { justify-self: start; display: inline-flex; align-items: center; min-height: var(--tap-min); color: var(--color-ink-muted); font-size: var(--text-sm); text-decoration: none; }
  @media (hover: hover) { .back-top:hover { color: var(--color-ink); text-decoration: underline; } }
  @media (min-width: 1024px) { .back-top { grid-column: 1 / -1; } .layout { row-gap: var(--space-4); } }
  .form { display: grid; gap: var(--space-8); max-width: 620px; }
  .guest { margin: 0; padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--color-lavender-soft); font-size: var(--text-sm); }
  section { display: grid; gap: var(--space-4); }
  h2 { font-size: var(--text-xl); }
  .row { display: grid; gap: var(--space-4); }
  @media (min-width: 480px) { .row { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: var(--space-1); font-size: var(--text-sm); color: var(--color-ink-muted); }
  label small, .label small { font-size: inherit; opacity: 0.8; }
  input:not([type='radio']):not([type='checkbox']), select {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-base); /* 16px stops iOS zooming into fields */
  }
  input:focus-visible, select:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 0; border-color: transparent; }
  input:user-invalid, select:user-invalid { border-color: #B3261E; }
  .phone { display: flex; }
  .phone > span { display: grid; place-items: center; padding: 0 var(--space-3); border: 1px solid var(--color-line); border-right: 0; border-radius: var(--radius-md) 0 0 var(--radius-md); background: var(--color-lavender-soft); color: var(--color-ink); font-size: var(--text-base); }
  .phone input { border-radius: 0 var(--radius-md) var(--radius-md) 0 !important; }
  .check { display: flex; align-items: center; gap: var(--space-2); color: var(--color-ink); min-height: var(--tap-min); }
  .check input { width: 20px; height: 20px; accent-color: var(--color-primary); }

  .segmented { display: grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: var(--radius-md); background: var(--color-lavender-soft); }
  .segmented label { display: block; }
  .segmented span { display: grid; place-items: center; min-height: 44px; border-radius: 6px; color: var(--color-ink); font-size: var(--text-base); cursor: pointer; }
  .segmented input:checked + span { background: var(--color-surface); box-shadow: 0 1px 4px rgb(28 22 34 / 0.12); font-weight: 500; }
  .segmented input:focus-visible + span { outline: 2px solid var(--color-violet); }

  .ship { display: grid; gap: var(--space-4); border: 0; margin: 0; padding: 0; min-width: 0; }
  .label { margin: var(--space-2) 0 0; font-size: var(--text-sm); color: var(--color-ink-muted); }
  .options { display: grid; border: 1px solid var(--color-line); border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface); }
  .option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: var(--text-base);
    cursor: pointer;
  }
  .option:first-child { border-top: 0; }
  .option:has(input:checked), .option.selected { background: var(--color-lavender-soft); }
  .option input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--color-primary); }
  .option-text small { display: block; margin-top: 2px; color: var(--color-ink-muted); font-size: var(--text-sm); }

  .paystack { border: 1px solid var(--color-primary); border-radius: var(--radius-md); overflow: hidden; }
  .paystack-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); padding: var(--space-4); background: var(--color-lavender-soft); }
  .paystack-head span { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .paystack p { margin: 0; padding: var(--space-4); font-size: var(--text-sm); text-align: center; }

  .notice { margin: 0; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-lavender-soft); color: var(--color-primary); }
  .actions { display: flex; flex-direction: column-reverse; gap: var(--space-4); align-items: stretch; }
  @media (min-width: 480px) { .actions { flex-direction: row; justify-content: space-between; align-items: center; } }
  .back { color: var(--color-ink-muted); font-size: var(--text-sm); text-align: center; }
  .pay { min-height: 52px; padding-inline: var(--space-12); font-size: var(--text-sm); }

  .summary { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
  .summary-toggle { display: flex; justify-content: space-between; align-items: center; min-height: 52px; padding: 0 var(--space-4); cursor: pointer; list-style: none; }
  .summary-toggle::-webkit-details-marker { display: none; }
  .summary-toggle span::after { content: ' ▾'; color: var(--color-ink-muted); }
  .summary[open] .summary-toggle span::after { content: ' ▴'; }
  @media (min-width: 1024px) { .summary-toggle { display: none; } }
  .summary-body { padding: var(--space-4) var(--space-4) var(--space-6); border-top: 1px solid var(--color-line); }
  @media (min-width: 1024px) { .summary-body { border-top: 0; padding: var(--space-6); } }
  .lines { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; gap: var(--space-4); }
  .lines :global(li) { display: grid; grid-template-columns: 88px minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; font-size: var(--text-sm); }
  .lines :global(.thumb) { position: relative; aspect-ratio: var(--ratio-product); border-radius: var(--radius-md); background: var(--color-lavender-soft); }
  .lines :global(.thumb img) { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-md); }
  .lines :global(.thumb b) { position: absolute; top: -8px; right: -8px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 11px; background: var(--color-primary); color: var(--color-on-dark); font-size: 12px; line-height: 22px; text-align: center; }
  .lines :global(.li-text) { font-size: var(--text-base); }
  .lines :global(.li-text small) { display: block; margin-top: 2px; color: var(--color-ink-muted); font-size: var(--text-sm); }
  dl { margin: 0; border-top: 1px solid var(--color-line); padding-top: var(--space-3); }
  dl div { display: flex; justify-content: space-between; padding-block: var(--space-1); font-size: var(--text-sm); }
  dd { margin: 0; }
  .total { margin-top: var(--space-2); font-size: var(--text-lg) !important; font-weight: 600; }
  .total small { font-size: var(--text-xs); font-weight: 400; color: var(--color-ink-muted); }
</style>
