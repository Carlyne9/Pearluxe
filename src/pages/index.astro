---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const newArrivals = products.filter((p) => p.isNew).slice(0, 4);

// Hero reel: plays one clip at a time in this order, then starts over. Add clips here (mp4 + jpg poster in public/videos/).
const clips = ['brown-buckle-bag', 'jacquard-shoulder-bags'];
---

<Base title="Pearluxe · Carry with elegance" overlayHeader>
  <main>
    <!-- The client's video IS the hero. Never replace it with a still image. -->
    <section class="hero">
      <div class="videos" aria-hidden="true">
        {clips.map((name, i) => (
          <div class:list={['clip', { active: i === 0 }]} data-clip>
            <!-- Wide screens: a blurred copy fills the sides around the sharp clip. -->
            <video class="ambient" src={`/videos/${name}.mp4`} poster={`/videos/${name}.jpg`} muted playsinline preload="none" tabindex="-1"></video>
            <video class="sharp" src={`/videos/${name}.mp4`} poster={`/videos/${name}.jpg`} muted playsinline preload={i === 0 ? 'auto' : 'metadata'} autoplay={i === 0}></video>
          </div>
        ))}
      </div>
      <div class="shade"></div>
      <div class="copy container">
        <p class="eyebrow caps">Our collection</p>
        <h1>Carry with elegance.</h1>
        <p class="lede">Classy, aesthetic pieces that finish every look, from brunch to after dark.</p>
        <div class="ctas">
          <a class="btn" href="/bags">Shop the collection</a>
          <a class="btn btn--light" href="#new-arrivals">New arrivals</a>
        </div>
      </div>
    </section>

    <section class="new container" id="new-arrivals">
      <header class="section-head">
        <h2>New arrivals</h2>
        <a class="see-all" href="/bags?tab=new">View all →</a>
      </header>
      <div class="grid">
        {newArrivals.map((p) => <ProductCard product={p} />)}
      </div>
      <a class="btn btn--outline more" href="/bags?tab=new">View all new arrivals</a>
    </section>
  </main>
</Base>

<script>
  const clips = [...document.querySelectorAll<HTMLElement>('[data-clip]')];
  const sharp = (c: HTMLElement) => c.querySelector<HTMLVideoElement>('.sharp')!;
  const ambient = (c: HTMLElement) => c.querySelector<HTMLVideoElement>('.ambient')!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches; // posters only
  const wide = matchMedia('(min-width: 1024px)');
  let current = 0;

  // Keep the blurred copy in step with the sharp clip (only shown on wide screens).
  function syncAmbient() {
    const clip = clips[current];
    const a = ambient(clip);
    if (!wide.matches || reduceMotion) return a.pause();
    a.preload = 'auto';
    if (Math.abs(a.currentTime - sharp(clip).currentTime) > 0.3) a.currentTime = sharp(clip).currentTime;
    a.play().catch(() => {});
  }

  function show(n: number) {
    clips[current].querySelectorAll('video').forEach((v) => v.pause());
    current = n;
    clips.forEach((c, i) => c.classList.toggle('active', i === n));
    const v = sharp(clips[n]);
    v.currentTime = 0;
    v.play().catch(() => {});
    syncAmbient();
    // Start loading the following clip so the switch has no gap.
    sharp(clips[(n + 1) % clips.length]).preload = 'auto';
  }

  clips.forEach((c, i) => {
    sharp(c).addEventListener('ended', () => { if (i === current) show((i + 1) % clips.length); });
    sharp(c).addEventListener('timeupdate', () => { if (i === current) syncAmbient(); });
  });
  wide.addEventListener('change', syncAmbient);

  if (reduceMotion) sharp(clips[0]).pause();
  else show(0);
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(92svh, 960px);
    margin-bottom: var(--space-16);
    background: var(--color-ink);
    color: var(--color-on-dark);
    overflow: hidden;
  }
  .videos { position: absolute; inset: 0; }
  .clip { position: absolute; inset: 0; opacity: 0; transition: opacity 600ms var(--ease); }
  .clip.active { opacity: 1; }
  .clip video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ambient { display: none; }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(20 14 24 / 0.78) 0%, rgb(20 14 24 / 0.35) 45%, rgb(20 14 24 / 0) 75%);
  }
  .copy { position: relative; padding-block: var(--space-16) var(--space-12); }
  .eyebrow { margin: 0 0 var(--space-4); }
  h1 { font-size: var(--text-hero); font-weight: 500; letter-spacing: -0.02em; max-width: 14ch; }
  .lede { margin: var(--space-4) 0 0; font-size: var(--text-lg); max-width: 36ch; opacity: 0.9; }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .btn--light { background: transparent; border-color: var(--color-on-dark); color: var(--color-on-dark); }
  /* Wide screens: the portrait clip sits sharp (zoomed out, whole bag visible) right of the copy,
     with a blurred, darkened copy of the same clip filling the rest as an ambient effect. */
  @media (min-width: 1024px) {
    .ambient { display: block; filter: blur(48px) brightness(0.65) saturate(1.2); transform: scale(1.2); }
    .clip .sharp {
      inset: 0 0 0 auto; /* flush right: no zoom, whole bag stays in frame */
      width: 44%;
      box-shadow: 0 0 80px rgb(0 0 0 / 0.35);
    }
    .shade { background: linear-gradient(to right, rgb(20 14 24 / 0.55) 0%, rgb(20 14 24 / 0) 56%); }
    .copy { width: 56%; max-width: none; margin: 0; padding-inline-end: var(--space-12); }
    h1 { max-width: 16ch; }
    .lede { max-width: 44ch; }
  }
  /* Desktop: wider video (50% = shown at its real size, no zoom), headline back to two lines, bigger CTAs. */
  @media (min-width: 1280px) {
    .clip .sharp { width: 50%; object-position: center 60%; }
    .shade { background: linear-gradient(to right, rgb(20 14 24 / 0.55) 0%, rgb(20 14 24 / 0) 50%); }
    .copy { width: 50%; }
    h1 { max-width: 14ch; }
    .lede { max-width: 36ch; }
    .ctas .btn { min-height: var(--space-12); padding-inline: var(--space-8); font-size: var(--text-sm); }
  }

  .new { padding-bottom: var(--space-24); }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-6); }
  h2 { font-size: var(--text-2xl); font-weight: 500; }
  .see-all { font-size: var(--text-sm); color: var(--color-primary); text-decoration: none; }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    gap: var(--space-12) var(--space-4);
  }
  /* 4 new arrivals: 2x2 on phones and iPad portrait, one row of 4 from iPad landscape up. */
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .more { display: flex; width: 100%; margin-top: var(--space-12); }
  @media (min-width: 768px) {
    .more { width: auto; display: inline-flex; }
  }
</style>
